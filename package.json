{
  "name": "@pi-innovations/proof",
  "version": "0.8.1",
  "description": "Run only the tests a change can affect, and share proof across clones and machines.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "proof": "src/cli.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "typescript": "^5.7.0"
  }
}
